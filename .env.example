DATABASE_URL=postgres://postgres:postgres@localhost:5432/actionguard?sslmode=disable
API_ADDR=:8080
MCP_ADDR=:8081
MCP_GATEWAY_TOKEN=local-dev-gateway-token
MCP_URL=http://localhost:8081/mcp
DEMO_FULL_TOKEN=actionguard-demo-full-token
DEMO_READ_ONLY_TOKEN=actionguard-demo-read-only-token
DEMO_USER_999_TOKEN=actionguard-demo-user-999-token
LLM_PROVIDER=deterministic
EMBEDDING_PROVIDER=deterministic
# To opt into OpenAI-compatible providers, set both provider values to openai
# and supply OPENAI_API_KEY, OPENAI_MODEL, and OPENAI_EMBEDDING_MODEL.
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=
